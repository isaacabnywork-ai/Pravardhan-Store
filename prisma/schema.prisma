datasource db {
  provider  = "postgresql"
  url       = env("POSTGRES_PRISMA_URL")
  directUrl = env("POSTGRES_URL_NON_POOLING")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  CUSTOMER
  PRODUCT_MANAGER
  STORE_MANAGER
  ORDER_MANAGER
  DELIVERY_STAFF
  SUPER_ADMIN
}

enum ProductStatus {
  PUBLISHED
  DRAFT
  OUT_OF_STOCK
  ARCHIVED
}

enum InventoryChangeType {
  STOCK_RECEIVED
  STOCK_ADJUSTMENT
  ORDER_RESERVED
  ORDER_CANCELLED
  ORDER_COMPLETED
  MANUAL_CORRECTION
}

model User {
  id           String    @id @default(cuid())
  phone        String?   @unique
  email        String?   @unique
  passwordHash String?
  name         String
  role         Role      @default(CUSTOMER)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  addresses    Address[]
  auditLogs    AuditLog[]
  movements    InventoryMovement[]
  cart         Cart?
  orders       Order[]
  deliveries   Order[]             @relation("StaffDeliveries")
  riderAssignments DeliveryAssignment[] @relation("RiderAssignments")
  redemptions  CouponRedemption[]
  notifications Notification[]

  @@map("users")
}

model Address {
  id           String    @id @default(cuid())
  userId       String
  label        String    @default("Home") // Home, Office, Other
  name         String
  phone        String
  houseNumber  String
  street       String
  landmark     String?
  area         String
  city         String
  pincode      String
  isDefault    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_addresses")
}

model Store {
  id                    String    @id @default(cuid())
  name                  String
  code                  String    @unique
  address               String
  city                  String
  serviceArea           String
  minOrderValue         Int       @default(10000) // In paise (₹100 = 10000)
  deliveryFee           Int       @default(0)     // In paise
  freeDeliveryThreshold Int       @default(0)
  operatingHours        String    @default("7:00 AM - 10:00 PM")
  supportPhone          String    @default("+91 124 456 7890")
  supportEmail          String    @default("care@pravdhanstore.in")
  isActive              Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  inventory             Inventory[]
  movements             InventoryMovement[]
  serviceAreas          ServiceArea[]
  orders                Order[]

  @@map("stores")
}

model Category {
  id           String         @id @default(cuid())
  name         String
  slug         String         @unique
  icon         String?
  image        String?
  description  String?
  displayOrder Int            @default(0)
  isActive     Boolean        @default(true)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  subcategories Subcategory[]
  products      Product[]

  @@map("categories")
}

model Subcategory {
  id           String    @id @default(cuid())
  categoryId   String
  name         String
  slug         String    @unique
  image        String?
  displayOrder Int       @default(0)
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  category     Category  @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products     Product[]

  @@index([categoryId])
  @@map("subcategories")
}

model Product {
  id            String          @id @default(cuid())
  name          String
  slug          String          @unique
  brand         String
  categoryId    String
  subcategoryId String?
  description   String?
  features      String[]        @default([])
  images        String[]        @default([])
  isFeatured    Boolean         @default(false)
  isPopular     Boolean         @default(false)
  isOrganic     Boolean         @default(false)
  rating        Float           @default(4.8)
  reviewCount   Int             @default(0)
  status        ProductStatus   @default(PUBLISHED)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  category      Category        @relation(fields: [categoryId], references: [id])
  subcategory   Subcategory?    @relation(fields: [subcategoryId], references: [id])
  variants      ProductVariant[]
  orderItems    OrderItem[]

  @@index([categoryId])
  @@index([subcategoryId])
  @@index([status])
  @@map("products")
}

model ProductVariant {
  id            String       @id @default(cuid())
  productId     String
  sku           String       @unique
  title         String
  unit          String       // e.g. "1 KG", "500g", "Pack of 2"
  mrp           Int          // In paise (₹150.00 = 15000)
  price         Int          // Selling price in paise
  image         String?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory     Inventory[]
  movements     InventoryMovement[]
  cartItems     CartItem[]
  orderItems    OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model Inventory {
  id                String         @id @default(cuid())
  storeId           String
  variantId         String
  quantity          Int            @default(0) // Available physical stock
  reservedQuantity  Int            @default(0) // In-progress checkout reservations
  lowStockThreshold Int            @default(5)
  updatedAt         DateTime       @updatedAt

  store             Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variant           ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([storeId, variantId])
  @@index([storeId])
  @@index([variantId])
  @@map("inventory")
}

model InventoryMovement {
  id             String              @id @default(cuid())
  storeId        String
  variantId      String
  changeType     InventoryChangeType
  quantityChange Int
  previousStock  Int
  newStock       Int
  reason         String
  updatedById    String?
  createdAt      DateTime            @default(now())

  store          Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  variant        ProductVariant      @relation(fields: [variantId], references: [id], onDelete: Cascade)
  updatedBy      User?               @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@index([storeId])
  @@index([variantId])
  @@index([createdAt])
  @@map("inventory_movements")
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actorRole String?
  action    String
  entity    String
  entityId  String
  details   Json?
  ipAddress String?
  createdAt DateTime @default(now())

  actor     User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model ServiceArea {
  id           String   @id @default(cuid())
  storeId      String
  name         String
  pincode      String
  deliveryFee  Int      @default(0) // In paise
  minOrder     Int      @default(10000) // In paise (₹100)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  store        Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@unique([storeId, pincode])
  @@index([pincode])
  @@map("store_service_areas")
}

model OtpChallenge {
  id         String   @id @default(cuid())
  phone      String
  codeHash   String
  attempts   Int      @default(0)
  isUsed     Boolean  @default(false)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([phone])
  @@index([expiresAt])
  @@map("otp_challenges")
}

enum DiscountType {
  PERCENTAGE
  FLAT
}

enum OrderStatus {
  PENDING_PAYMENT
  PLACED
  CONFIRMED
  PREPARING
  READY_FOR_PICKUP
  OUT_FOR_DELIVERY
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentMethod {
  COD
  UPI
  CARD
  WALLET
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Cart {
  id         String     @id @default(cuid())
  userId     String?    @unique
  sessionId  String?    @unique
  couponCode String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  items      CartItem[]
  user       User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("carts")
}

model CartItem {
  id         String         @id @default(cuid())
  cartId     String
  variantId  String
  quantity   Int            @default(1)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  cart       Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant    ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([cartId])
  @@index([variantId])
  @@map("cart_items")
}

model Coupon {
  id            String         @id @default(cuid())
  code          String         @unique
  title         String
  description   String
  discountType  DiscountType   @default(PERCENTAGE)
  discountValue Int            // In paise or percentage (e.g. 20 for 20%, 5000 for ₹50)
  minOrderValue Int            @default(10000) // In paise (₹100 = 10000)
  maxDiscount   Int?           // In paise
  usageLimit    Int?
  perUserLimit  Int            @default(1)
  validTill     DateTime
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  redemptions   CouponRedemption[]

  @@map("coupons")
}

model CouponRedemption {
  id        String   @id @default(cuid())
  couponId  String
  userId    String
  orderId   String
  discount  Int      // Saved discount amount in paise
  createdAt DateTime @default(now())

  coupon    Coupon   @relation(fields: [couponId], references: [id])
  user      User     @relation(fields: [userId], references: [id])
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([couponId])
  @@index([userId])
  @@index([orderId])
  @@map("coupon_redemptions")
}

model Order {
  id                 String               @id @default(cuid())
  orderNumber        String               @unique // e.g. PRV-2026-XXXX
  userId             String
  storeId            String
  deliveryStaffId    String?
  customerName       String
  customerPhone      String
  
  deliveryAddress    Json                 // Immutable snapshot
  deliverySlot       String               @default("Instant (10-15 mins)")
  
  subtotal           Int                  // in paise
  discount           Int                  @default(0)
  couponCode         String?
  couponDiscount     Int                  @default(0)
  deliveryFee        Int                  @default(0)
  deliveryTip        Int                  @default(0)
  handlingFee        Int                  @default(0)
  grandTotal         Int                  // in paise
  
  paymentMethod      PaymentMethod        @default(COD)
  paymentStatus      PaymentStatus        @default(PENDING)
  orderStatus        OrderStatus          @default(PLACED)
  notes              String?
  cancellationReason String?
  
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  user               User                 @relation(fields: [userId], references: [id])
  store              Store                @relation(fields: [storeId], references: [id])
  deliveryStaff      User?                @relation("StaffDeliveries", fields: [deliveryStaffId], references: [id])
  items              OrderItem[]
  statusHistory      OrderStatusHistory[]
  payments           Payment[]
  redemptions        CouponRedemption[]
  deliveryAssignments DeliveryAssignment[]

  @@index([userId])
  @@index([storeId])
  @@index([orderStatus])
  @@index([orderNumber])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id             String         @id @default(cuid())
  orderId        String
  productId      String
  variantId      String
  productName    String
  variantTitle   String
  brand          String
  unit           String
  purchasedPrice Int            // Preserved historical price in paise
  purchasedMrp   Int            // Preserved historical MRP in paise
  quantity       Int
  image          String?
  createdAt      DateTime       @default(now())

  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product        Product        @relation(fields: [productId], references: [id])
  variant        ProductVariant @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  status    OrderStatus
  label     String
  note      String?
  actorId   String?
  createdAt DateTime    @default(now())

  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([createdAt])
  @@map("order_status_history")
}

model Payment {
  id                 String        @id @default(cuid())
  orderId            String
  paymentMethod      PaymentMethod
  paymentStatus      PaymentStatus @default(PENDING)
  amount             Int           // in paise
  gatewayOrderId     String?       // Razorpay order ID
  gatewayPaymentId   String?       // Razorpay payment ID
  gatewaySignature   String?
  gatewayRawResponse Json?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  order              Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([gatewayOrderId])
  @@map("payments")
}

enum AssignmentStatus {
  ASSIGNED
  ACCEPTED
  REJECTED
  PICKED_UP
  DELIVERED
  FAILED
}

model DeliveryAssignment {
  id              String           @id @default(cuid())
  orderId         String
  riderId         String
  status          AssignmentStatus @default(ASSIGNED)
  assignedAt      DateTime         @default(now())
  acceptedAt      DateTime?
  pickedUpAt      DateTime?
  deliveredAt     DateTime?
  failedAt        DateTime?
  failureReason   String?
  customerOtp     String?          // 4-digit verification OTP (e.g. "4829")
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  order           Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rider           User             @relation("RiderAssignments", fields: [riderId], references: [id])

  @@index([orderId])
  @@index([riderId])
  @@index([status])
  @@map("delivery_assignments")
}

enum NotificationChannel {
  IN_APP
  SMS
  EMAIL
  PUSH
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  title     String
  message   String
  channel   NotificationChannel @default(IN_APP)
  orderId   String?
  isRead    Boolean             @default(false)
  metadata  Json?
  createdAt DateTime            @default(now())

  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}
