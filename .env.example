# Pravdhan Store Environment Variables

# PostgreSQL on Neon
DATABASE_URL="postgresql://user:password@ep-example-pooler.region.neon.tech/pravdhan_store?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://user:password@ep-example.region.neon.tech/pravdhan_store?sslmode=require"

# Auth.js / JWT Session Secret
AUTH_SECRET="your-super-secret-random-key-at-least-32-characters"
AUTH_URL="https://pravdhan-store.vercel.app"

# Initial Bootstrap Administrator (Disabled after initial seeding)
BOOTSTRAP_ADMIN_EMAIL="admin@pravdhanstore.in"
BOOTSTRAP_ADMIN_PASSWORD="ReplaceWithSecurePassword2026!"

# Razorpay Payment Gateway (Phase 6)
RAZORPAY_KEY_ID="rzp_test_..."
RAZORPAY_KEY_SECRET="..."
RAZORPAY_WEBHOOK_SECRET="..."

# Image Storage (Cloudinary / Supabase Storage)
STORAGE_BUCKET=""
STORAGE_API_KEY=""
STORAGE_API_SECRET=""

# Error Monitoring (Optional)
SENTRY_DSN=""
